# Copy to backend/.env and fill in. backend/.env is git-ignored. Every key is optional:
# without Groq the chat uses the offline guide, without Gnani the browser voice reads aloud,
# without Twilio alerts stay in the outbox as "simulated".

# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require   (default: local SQLite)
# JALSETU_ENV=production     # hosted only: refuses the secret below and SQLite, and does not seed on start
JALSETU_SECRET=change-me
# JALSETU_OFFLINE=1          # skip the Open-Meteo call (rain falls back to the CHIRPS district mean)

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=qwen/qwen3.8-27b

GNANI_API_KEY=
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_TEST_TO=whatsapp:+91XXXXXXXXXX
